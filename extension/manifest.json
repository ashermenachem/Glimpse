{
  "manifest_version": 3,
  "name": "Glimpse",
  "version": "0.5.0",
  "description": "Your GPA at a glance inside MyMilken. Created by Asher Menachem.",
  "content_scripts": [
    {
      "matches": [
        "https://milkenschool.myschoolapp.com/*"
      ],
      "js": [
        "core.js",
        "personalize.js",
        "widget.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "widget.css"
      ],
      "matches": [
        "https://milkenschool.myschoolapp.com/*"
      ]
    }
  ],
  "short_name": "Glimpse",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Glimpse",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "author": "Asher Menachem"
}
